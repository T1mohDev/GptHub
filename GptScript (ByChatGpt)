local function RebuildSearch()

    for _, child in ipairs(
        Results:GetChildren()
    ) do

        if child:IsA("TextButton") then

            child:Destroy()

        end

    end


    local query =
        string.lower(
            SearchBox.Text
        )


    for _, name in ipairs(
        SearchFunctions
    ) do

        if query == ""
            or string.find(
                string.lower(name),
                query,
                1,
                true
            ) then


            local button =
                Instance.new("TextButton")


            button.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    34
                )


            button.BackgroundColor3 =
                C.BLACK2


            button.Text =
                name


            button.TextColor3 =
                C.WHITE


            button.Font =
                Enum.Font.GothamMedium


            button.TextSize =
                10


            button.AutoButtonColor =
                false


            button.ZIndex =
                52


            button.Parent =
                Results


            local corner =
                Instance.new("UICorner")


            corner.CornerRadius =
                UDim.new(
                    0,
                    7
                )


            corner.Parent =
                button


            button.MouseButton1Click:Connect(
                function()

                    RunSearchFunction(
                        name
                    )

                end
            )

        end

    end

end



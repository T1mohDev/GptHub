local function showMenu()

	MenuVisible = true
	Main.Visible = true

	local normalSize =
		WindowSizes.Normal.size

	Main.Size =
		UDim2.new(
			0,
			math.floor(
				normalSize.X.Offset * 0.94
			),
			0,
			math.floor(
				normalSize.Y.Offset * 0.94
			)
		)

	tween(
		Main,
		{
			Size = normalSize
		},
		0.22,
		Enum.EasingStyle.Back
	)

end

local function hideMenu()

	MenuVisible = false

	local animation =
		tween(
			Main,
			{
				Size =
					UDim2.new(0, 0, 0, 0)
			},
			0.18
		)

	animation.Completed:Connect(function()

		if not MenuVisible then
			Main.Visible = false
		end

	end)

end

UserInputService.InputBegan:Connect(function(
	input,
	processed
)

	if processed then
		return
	end

	if input.KeyCode == MENU_KEY then

		if MenuVisible then
			hideMenu()
		else
			showMenu()
		end

	end

end)


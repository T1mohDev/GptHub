-- GOD MODE
---------------------------------------------------------------

local function UpdateGodMode()

    if not State.GodMode then
        return
    end


    local _, hum =
        GetCharacter()


    if not hum then
        return
    end


    if hum.Health <
        hum.MaxHealth then

        hum.Health =
            hum.MaxHealth

    end

end


---------------------------------------------------------------
-- CHAOS ACTIONS
---------------------------------------------------------------

local function Flip()

    local _, _, root =
        GetCharacter()


    if root then

        root:ApplyAngularImpulse(
            Vector3.new(
                math.random(
                    -35,
                    35
                ),
                math.random(
                    -35,
                    35
                ),
                math.random(
                    -35,
                    35
                )
            )
        )


        Notify(
            "Flip",
            "Вращение запущено"
        )

    end

end


local function Launch()

    local _, _, root =
        GetCharacter()


    if root then

        root:ApplyImpulse(
            Camera.CFrame.LookVector *
            120
        )


        Notify(
            "Launch",
            "ВЖУХ"
        )

    end

end


local function RandomLaunch()

    local _, _, root =
        GetCharacter()


    if root then

        local direction =
            Vector3.new(
                math.random(
                    -100,
                    100
                ),
                math.random(
                    25,
                    110
                ),
                math.random(
                    -100,
                    100
                )
            )


        if direction.Magnitude >
            0 then

            root:ApplyImpulse(
                direction.Unit *
                math.random(
                    80,
                    160
                )
            )

        end


        Notify(
            "Random Launch",
            "Куда-то улетел"
        )

    end

end


local function Yeet()

    local _, _, root =
        GetCharacter()


    if root then

        root:ApplyImpulse(
            Vector3.new(
                math.random(
                    -80,
                    80
                ),
                140,
                math.random(
                    -80,
                    80
                )
            )
        )


        Notify(
            "YEET",
            "🚀"
        )

    end

end



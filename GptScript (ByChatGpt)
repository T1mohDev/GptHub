        if input.KeyCode ==
            Enum.KeyCode.Insert then

            State.Visible =
                not State.Visible


            Main.Visible =
                State.Visible


            if State.Visible then

                Notify(
                    "UltraGpt",
                    "Меню открыто"
                )

            end

        end


        -------------------------------------------------------
        -- R = LAUNCH
        -------------------------------------------------------

        if input.KeyCode ==
            Enum.KeyCode.R then

            Launch()

        end

    end
)



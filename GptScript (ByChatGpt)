---------------------------------------------------------------
-- RANDOM SPIN
---------------------------------------------------------------

local function UpdateRandomSpin(
    delta
)

    if not State.RandomSpin then
        return
    end


    RandomSpinTimer -=
        delta


    if RandomSpinTimer <= 0 then

        RandomSpinTimer =
            math.random(
                8,
                18
            ) / 10


        local _, _, root =
            GetCharacter()


        if root then

            root:ApplyAngularImpulse(
                Vector3.new(
                    math.random(
                        -15,
                        15
                    ),
                    math.random(
                        -15,
                        15
                    ),
                    math.random(
                        -15,
                        15
                    )
                )
            )

        end

    end

end


---------------------------------------------------------------

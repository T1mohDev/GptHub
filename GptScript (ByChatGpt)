---------------------------------------------------------------
-- ANIMATION
---------------------------------------------------------------

local function StopAnimation()

    if State.CurrentAnimation then

        pcall(
            function()

                State.CurrentAnimation:Stop(
                    0.15
                )

            end
        )

    end


    State.CurrentAnimation =
        nil


    if State.CurrentAnimationObject then

        State.CurrentAnimationObject:
            Destroy()

        State.CurrentAnimationObject =
            nil

    end

end


local function PlayAnimation(
    animationId
)

    local id =
        tonumber(
            tostring(
                animationId or ""
            ):gsub(
                "%s+",
                ""
            )
        )


    if not id then

        Notify(
            "Animation",
            "Введите корректный ID"
        )

        return

    end


    local _, hum =
        GetCharacter()


    if not hum then
        return
    end


    local animator =
        hum:FindFirstChildOfClass(
            "Animator"
        )


    if not animator then

        animator =
            Instance.new(
                "Animator"
            )

        animator.Parent =
            hum

    end


    StopAnimation()


    local animation =
        Instance.new(
            "Animation"
        )


    animation.Name =
        "UltraGptCustomAnimation"


    animation.AnimationId =
        "rbxassetid://"
        ..
        tostring(id)


    local success, track =
        pcall(
            function()

                return animator:
                    LoadAnimation(
                        animation
                    )

            end
        )


    if not success
        or not track then

        animation:Destroy()


        Notify(
            "Animation",
            "Не удалось загрузить анимацию"
        )


        return

    end


    track.Priority =
        Enum.AnimationPriority.Action


    track.Looped =
        false


    track:Play(
        0.15,
        1,
        1
    )


    State.AnimationId =
        id

    State.CurrentAnimation =
        track

    State.CurrentAnimationObject =
        animation


    Notify(
        "Animation",
        "Запущено: "
        .. tostring(id)
    )

end


local function ReplayAnimation()

    if State.CurrentAnimation then

        pcall(
            function()

                State.CurrentAnimation:
                    Stop(
                        0
                    )

                State.CurrentAnimation:
                    Play(
                        0.1,
                        1,
                        1
                    )

            end
        )


        Notify(
            "Animation",
            "Replay"
        )


        return

    end


    if State.AnimationId then

        PlayAnimation(
            State.AnimationId
        )

    else

        Notify(
            "Animation",
            "Сначала введи ID"
        )

    end

end



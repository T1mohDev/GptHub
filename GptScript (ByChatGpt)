local function UpdateRainbow()

    if not State.Rainbow then
        return
    end


    RainbowHue +=
        0.003


    if RainbowHue > 1 then
        RainbowHue =
            0
    end


    local color =
        Color3.fromHSV(
            RainbowHue,
            0.75,
            1
        )


    local char =
        GetCharacter()


    for _, object in ipairs(
        char:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            object.Color =
                color

        end

    end

end



local function stopFly()
	State.Fly = false
	disconnect("Fly")

	if RootPart then
		local velocity = RootPart:FindFirstChild("UltraGptVelocity")
		if velocity then
			velocity:Destroy()
		end

		local gyro = RootPart:FindFirstChild("UltraGptGyro")
		if gyro then
			gyro:Destroy()
		end
	end

	if Humanoid then
		Humanoid.AutoRotate = State.AutoRotate
	end

	setToggle(Fly, false)
end

local function startFly()
	if not RootPart or not Humanoid then
		return
	end

	State.Fly = true
	Humanoid.AutoRotate = false

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "UltraGptVelocity"
	velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	velocity.Velocity = Vector3.zero
	velocity.Parent = RootPart

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "UltraGptGyro"
	gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	gyro.P = 12000
	gyro.Parent = RootPart

	Connections.Fly = RunService.RenderStepped:Connect(function()
		if not State.Fly or not RootPart then
			return
		end

		local cam = workspace.CurrentCamera
		local direction = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction += cam.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction -= cam.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction -= cam.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction += cam.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.new(0, 1, 0)
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.new(0, 1, 0)
		end

		if direction.Magnitude > 0 then
			direction = direction.Unit * FLY_SPEED
		end

		velocity.Velocity = direction

		gyro.CFrame = CFrame.lookAt(
			RootPart.Position,
			RootPart.Position + cam.CFrame.LookVector
		)
	end)

	setToggle(Fly, true)
end

Fly.Button.MouseButton1Click:Connect(function()
	if State.Fly then
		stopFly()
		notify("Fly OFF")
	else
		startFly()
		notify("Fly ON")
	end
end)


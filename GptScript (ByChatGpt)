local function createButton(parent, text, description)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, -5, 0, 54)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundColor3 = BUTTON
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.Parent = holder

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(50, 50, 65)
	stroke.Thickness = 1
	stroke.Parent = button

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -90, 0, 22)
	label.Position = UDim2.new(0, 15, 0, 6)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = TEXT
	label.TextSize = 12
	label.Font = Enum.Font.GothamSemibold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	local desc = Instance.new("TextLabel")
	desc.Size = UDim2.new(1, -90, 0, 18)
	desc.Position = UDim2.new(0, 15, 0, 28)
	desc.BackgroundTransparency = 1
	desc.Text = description or ""
	desc.TextColor3 = SUBTEXT
	desc.TextSize = 9
	desc.Font = Enum.Font.Gotham
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.Parent = button

	local indicator = Instance.new("TextLabel")
	indicator.Size = UDim2.new(0, 65, 0, 22)
	indicator.Position = UDim2.new(1, -75, 0.5, -11)
	indicator.BackgroundTransparency = 1
	indicator.Text = "OFF"
	indicator.TextColor3 = SUBTEXT
	indicator.TextSize = 10
	indicator.Font = Enum.Font.GothamBold
	indicator.TextXAlignment = Enum.TextXAlignment.Right
	indicator.Parent = button

	button.MouseEnter:Connect(function()
		tween(button, {
			BackgroundColor3 = BUTTON_HOVER
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		if button:GetAttribute("Enabled") then
			tween(button, {
				BackgroundColor3 = Color3.fromRGB(46, 39, 60)
			}, 0.12)
		else
			tween(button, {
				BackgroundColor3 = BUTTON
			}, 0.12)
		end
	end)

	button.MouseButton1Down:Connect(function()
		tween(button, {
			Size = UDim2.new(0.98, 0, 0.94, 0)
		}, 0.07)
	end)

	button.MouseButton1Up:Connect(function()
		tween(button, {
			Size = UDim2.new(1, 0, 1, 0)
		}, 0.1)
	end)

	return {
		Holder = holder,
		Button = button,
		Label = label,
		Description = desc,
		Indicator = indicator
	}
end

local function setToggle(object, enabled)
	object.Button:SetAttribute("Enabled", enabled)

	if enabled then
		object.Indicator.Text = "ON"
		object.Indicator.TextColor3 = SUCCESS

		tween(object.Button, {
			BackgroundColor3 = Color3.fromRGB(46, 39, 60)
		}, 0.15)
	else
		object.Indicator.Text = "OFF"
		object.Indicator.TextColor3 = SUBTEXT

		tween(object.Button, {
			BackgroundColor3 = BUTTON
		}, 0.15)
	end
end


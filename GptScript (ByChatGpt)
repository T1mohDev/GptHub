	desc.TextColor3 = SUBTEXT
	desc.TextSize = 9
	desc.Font = Enum.Font.Gotham
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.Parent = button

	local indicator = Instance.new("TextLabel")
	indicator.Size = UDim2.new(0, 70, 0, 22)
	indicator.Position = UDim2.new(1, -80, 0.5, -11)
	indicator.BackgroundTransparency = 1
	indicator.Text = "OFF"
	indicator.TextColor3 = SUBTEXT
	indicator.TextSize = 10
	indicator.Font = Enum.Font.GothamBold
	indicator.TextXAlignment = Enum.TextXAlignment.Right
	indicator.Parent = button

	button.MouseEnter:Connect(function()
		tween(button, {
			BackgroundColor3 = BUTTON_HOVER
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		if button:GetAttribute("Enabled") then
			tween(button, {
				BackgroundColor3 = Color3.fromRGB(46, 39, 60)
			}, 0.12)
		else
			tween(button, {
				BackgroundColor3 = BUTTON
			}, 0.12)
		end
	end)

	return {
		Button = button,
		Indicator = indicator
	}
end

local function setToggle(object, enabled)
	object.Button:SetAttribute("Enabled", enabled)

	if enabled then
		object.Indicator.Text = "ON"
		object.Indicator.TextColor3 = SUCCESS

		tween(object.Button, {
			BackgroundColor3 = Color3.fromRGB(46, 39, 60)
		}, 0.12)
	else
		object.Indicator.Text = "OFF"
		object.Indicator.TextColor3 = SUBTEXT

		tween(object.Button, {
			BackgroundColor3 = BUTTON
		}, 0.12)
	end
end


local function selectPage(name)
	currentPage = name

	for pageName, page in pairs(pageFrames) do
		page.Visible = pageName == name
	end

	for buttonName, object in pairs(navButtons) do
		if buttonName == name then
			object.BackgroundColor3 = ACCENT_DARK
			object.Icon.TextColor3 = TEXT
			object.Label.TextColor3 = TEXT

			tween(object, {
				Position = UDim2.new(
					0, 5, 0, 0
				)
			}, 0.15)
		else
			object.BackgroundColor3 = BUTTON
			object.Icon.TextColor3 = SUBTEXT
			object.Label.TextColor3 = SUBTEXT

			tween(object, {
				Position = UDim2.new(
					0, 0, 0, 0
				)
			}, 0.15)
		end
	end

	for _, item in ipairs(navItems) do
		if item.name == name then
			pageTitle.Text = item.title
			pageSub.Text = item.sub
			break
		end
	end
end


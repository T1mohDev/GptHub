local function createPlayerButton(targetPlayer)

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 0, 42)
	button.BackgroundColor3 = BUTTON
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.Parent = PlayerList

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	local displayName = Instance.new("TextLabel")
	displayName.Size = UDim2.new(1, -100, 0, 19)
	displayName.Position = UDim2.new(0, 12, 0, 4)
	displayName.BackgroundTransparency = 1
	displayName.Text = targetPlayer.DisplayName
	displayName.TextColor3 = TEXT
	displayName.TextSize = 11
	displayName.Font = Enum.Font.GothamSemibold
	displayName.TextXAlignment = Enum.TextXAlignment.Left
	displayName.Parent = button

	local username = Instance.new("TextLabel")
	username.Size = UDim2.new(1, -100, 0, 15)
	username.Position = UDim2.new(0, 12, 0, 23)
	username.BackgroundTransparency = 1
	username.Text = "@" .. targetPlayer.Name
	username.TextColor3 = SUBTEXT
	username.TextSize = 9
	username.Font = Enum.Font.Gotham
	username.TextXAlignment = Enum.TextXAlignment.Left
	username.Parent = button

	local target = Instance.new("TextLabel")
	target.Size = UDim2.new(0, 65, 1, 0)
	target.Position = UDim2.new(1, -75, 0, 0)
	target.BackgroundTransparency = 1
	target.Text = "SELECT"
	target.TextColor3 = ACCENT
	target.TextSize = 9
	target.Font = Enum.Font.GothamBold
	target.TextXAlignment = Enum.TextXAlignment.Right
	target.Parent = button

	if targetPlayer == LocalPlayer then
		target.Text = "YOU"
		target.TextColor3 = WARNING
	end

	button.MouseEnter:Connect(function()
		tween(button, {
			BackgroundColor3 = BUTTON_HOVER
		}, 0.12)
	end)

	button.MouseLeave:Connect(function()
		if SelectedPlayer == targetPlayer then
			tween(button, {
				BackgroundColor3 = Color3.fromRGB(46, 39, 60)
			}, 0.12)
		else
			tween(button, {
				BackgroundColor3 = BUTTON
			}, 0.12)
		end
	end)

	button.MouseButton1Click:Connect(function()

		SelectedPlayer = targetPlayer

		PlayerTarget.Text =
			"Target: " ..
			targetPlayer.DisplayName ..
			"  (@" ..
			targetPlayer.Name ..
			")"

		notify(
			"Selected: " ..
			targetPlayer.DisplayName
		)

		for _, child in ipairs(PlayerList:GetChildren()) do
			if child:IsA("TextButton") then
				if child == button then
					child.BackgroundColor3 =
						Color3.fromRGB(46, 39, 60)
				else
					child.BackgroundColor3 = BUTTON
				end
			end
		end
	end)

	return button
end

local function refreshPlayerList()

	for _, child in ipairs(PlayerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local allPlayers = Players:GetPlayers()

	table.sort(
		allPlayers,
		function(a, b)
			return a.Name:lower() < b.Name:lower()
		end
	)

	for _, targetPlayer in ipairs(allPlayers) do
		createPlayerButton(targetPlayer)
	end

	notify(
		"Players: " ..
		#allPlayers
	)
end

refreshPlayerList()


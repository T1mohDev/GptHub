    player
)

    if not player then

        Notify(
            "Teleport",
            "Игрок не выбран"
        )


        return

    end


    local character =
        player.Character


    if not character then

        Notify(
            "Teleport",
            "Персонаж недоступен"
        )


        return

    end


    local targetRoot =
        character:FindFirstChild(

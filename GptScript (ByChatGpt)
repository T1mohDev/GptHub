local fps = 60
local frames = 0
local fpsTime = 0

RunService.RenderStepped:Connect(function(delta)
	frames += 1
	fpsTime += delta

	if fpsTime >= 1 then
		fps = math.floor(frames / fpsTime)

		frames = 0
		fpsTime = 0
	end

	if rootPart then
		local pos = rootPart.Position

		hudText.Text =
			"UltraGpt v3" ..
			"\nFPS: " .. fps ..
			"\nXYZ: " ..
			math.floor(pos.X) ..
			", " ..
			math.floor(pos.Y) ..
			", " ..
			math.floor(pos.Z)
	end
end)


local function SafeNumber(
    value,
    minimum,
    maximum
)

    local number =
        tonumber(value)

    if not number then
        return nil
    end

    return math.clamp(
        number,
        minimum,
        maximum
    )

end


local function DestroyObject(
    object
)

    if object then

        pcall(
            function()

                object:Destroy()

            end
        )

    end

    return nil

end



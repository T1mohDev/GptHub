---------------------------------------------------------------
-- TAB SWITCH
---------------------------------------------------------------

local function SwitchTab(
    selected
)

    for name, button in pairs(
        TabButtons
    ) do

        if name == selected then

            button.BackgroundColor3 =
                C.WHITE

            button.TextColor3 =
                C.BLACK

        else

            button.BackgroundColor3 =
                C.BLACK2

            button.TextColor3 =
                C.GRAY

        end

    end


    for name, page in pairs(
        Pages
    ) do

        page.Visible =
            name == selected

    end

end


for name, button in pairs(
    TabButtons
) do

    button.MouseButton1Click:Connect(
        function()

            SwitchTab(
                name
            )

        end
    )

end



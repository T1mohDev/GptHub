            0,
            0
        )

    status.Size =
        UDim2.new(
            0.28,
            -10,
            1,
            0
        )

    status.Text =
        toggle
        and (
            GetState(name)
            and "ON"
            or "OFF"
        )
        or "RUN"

    status.TextColor3 =
        toggle
        and (
            GetState(name)
            and C.GREEN
            or C.RED
        )
        or C.WHITE

    status.Font =
        Enum.Font.GothamBold

    status.TextSize =
        9

    status.TextXAlignment =
        Enum.TextXAlignment.Right

    status.Parent =
        button


    button.MouseEnter:Connect(
        function()

            TweenService:Create(
                button,
                TweenInfo.new(
                    0.12
                ),
                {
                    BackgroundColor3 =
                        C.CARD2
                }
            ):Play()

        end
    )


    button.MouseLeave:Connect(
        function()

            TweenService:Create(
                button,
                TweenInfo.new(
                    0.12
                ),
                {
                    BackgroundColor3 =
                        C.CARD
                }
            ):Play()

        end
    )


    button.MouseButton1Click:Connect(
        function()

            callback()


            if toggle then

                task.defer(
                    function()

                        local active =
                            GetState(
                                name
                            )

                        status.Text =
                            active
                            and "ON"
                            or "OFF"

                        status.TextColor3 =
                            active
                            and C.GREEN
                            or C.RED

                    end
                )

            end

        end
    )


    return button

end



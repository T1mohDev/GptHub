        -------------------------------------------------------
        -- FUN
        -------------------------------------------------------

        UpdateSpace(
            delta
        )

        UpdateFloat()

        UpdateSpin()

        UpdateRandomSpin(
            delta
        )

        UpdateTornado(
            delta
        )


        -------------------------------------------------------
        -- ORBITS
        -------------------------------------------------------

        UpdateOrbit(
            delta
        )

        UpdatePlayerOrbit(
            delta
        )

        UpdateFollow()


        -------------------------------------------------------
        -- NOCLIP
        -------------------------------------------------------

        if State.NoClip then

            for _, object in ipairs(
                Character:GetDescendants()
            ) do

                if object:IsA("BasePart") then

                    object.CanCollide =
                        false

                end

            end

        end


        -------------------------------------------------------
        -- RAINBOW
        -------------------------------------------------------

        UpdateRainbow()

    end
)



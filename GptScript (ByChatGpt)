local function UpdatePlayerOrbit(
    delta
)

    if not State.PlayerOrbit then
        return
    end


    local player =
        State.SelectedPlayer


    if not player then

        State.PlayerOrbit =
            false

        return

    end


    local character =
        player.Character


    if not character then
        return
    end


    local targetRoot =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    local _, _, root =
        GetCharacter()


    if not targetRoot
        or not root then

        return
    end


    if not PlayerOrbitPosition then

        PlayerOrbitAttachment,
        PlayerOrbitPosition =
            CreatePositionForce(
                root,
                "UltraGptPlayerOrbit"
            )

    end


    PlayerOrbitAngle +=
        delta *
        State.OrbitSpeed


    local x =
        math.cos(
            PlayerOrbitAngle
        ) *
        State.OrbitRadius


    local z =
        math.sin(
            PlayerOrbitAngle
        ) *
        State.OrbitRadius


    local y =
        State.OrbitHeight
        +
        math.sin(
            PlayerOrbitAngle *
            0.5
        ) *
        2


    local destination =
        targetRoot.Position +
        Vector3.new(
            x,
            y,
            z
        )


    PlayerOrbitPosition.Position =
        destination

end



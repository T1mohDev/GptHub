---------------------------------------------------------------

local function UpdateTornado(
    delta
)

    if not State.Tornado then
        return
    end


    local _, _, root =
        GetCharacter()


    if not root then
        return
    end


    local force =
        Vector3.new(
            math.cos(
                os.clock() * 8
            ),
            0,
            math.sin(
                os.clock() * 8
            )
        )


    root:ApplyImpulse(
        force *
        (
            15 *
            delta *
            60
        )
    )

end



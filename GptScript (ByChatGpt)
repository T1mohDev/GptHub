-- NOCLIP
---------------------------------------------------------------

local function SaveNoClipValues()

    table.clear(
        NoClipSaved
    )


    local char =
        GetCharacter()


    for _, object in ipairs(
        char:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            NoClipSaved[object] =
                object.CanCollide

        end

    end

end


local function SetNoClip(
    enabled
)

    State.NoClip =
        enabled


    local char =
        GetCharacter()


    if enabled then

        SaveNoClipValues()


        for _, object in ipairs(
            char:GetDescendants()
        ) do

            if object:IsA("BasePart") then

                object.CanCollide =
                    false

            end

        end


        Notify(
            "NoClip",
            "Столкновения отключены"
        )

    else

        for object, original in pairs(
            NoClipSaved
        ) do

            if object
                and object.Parent
                and object:IsA("BasePart") then

                object.CanCollide =
                    original

            end
        end


        table.clear(
            NoClipSaved
        )


        Notify(
            "NoClip",
            "Столкновения восстановлены"
        )

    end

end



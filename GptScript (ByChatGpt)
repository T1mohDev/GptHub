-- Только редкие небольшие импульсы.
---------------------------------------------------------------

local function SetSpace(
    enabled
)

    State.Space =
        enabled


    local _, hum =
        GetCharacter()


    if enabled then

        Workspace.Gravity =
            0


        if hum then

            hum.PlatformStand =
                true

        end


        SpaceTimer =
            0


        Notify(
            "SPACE",
            "Gravity = 0 • свободная физика"
        )

    else

        Workspace.Gravity =
            OriginalGravity


        if hum then

            hum.PlatformStand =
                false

        end


        Notify(
            "SPACE",
            "Гравитация восстановлена"
        )

    end

end


local function UpdateSpace(
    delta
)

    if not State.Space then
        return
    end


    local _, _, root =
        GetCharacter()


    if not root then
        return
    end


    SpaceTimer -=
        delta


    if SpaceTimer <= 0 then

        SpaceTimer =
            math.random(
                80,
                160
            ) / 100


        local direction =
            Vector3.new(
                math.random(
                    -100,
                    100
                ) / 100,

                math.random(
                    -100,
                    100
                ) / 100,

                math.random(
                    -100,
                    100
                ) / 100
            )


        if direction.Magnitude > 0 then

            direction =
                direction.Unit


            root:ApplyImpulse(
                direction *
                math.random(
                    18,
                    30
                )
            )

        end

    end

end


---------------------------------------------------------------
-- NORMAL ORBIT
---------------------------------------------------------------

local function SetOrbit(
    enabled
)

    State.Orbit =
        enabled


    local _, _, root =
        GetCharacter()


    if enabled then

        if not root then

            State.Orbit =
                false

            return

        end


        OrbitCenter =
            root.Position


        OrbitAngle =
            0


        Notify(
            "Orbit",
            "Центр орбиты сохранён"
        )

    else

        OrbitCenter =
            nil


        if NormalOrbitPosition then

            NormalOrbitPosition:Destroy()

            NormalOrbitPosition =
                nil

        end


        if NormalOrbitAttachment then

            NormalOrbitAttachment:Destroy()

            NormalOrbitAttachment =
                nil

        end


        Notify(
            "Orbit",
            "Выключен"
        )

    end

end


local function UpdateOrbit(
    delta
)

    if not State.Orbit
        or not OrbitCenter then

        return
    end


    local _, _, root =
        GetCharacter()


    if not root then
        return
    end


    OrbitAngle +=
        delta *
        0.55


    local radius =
        14


    local targetPosition =
        OrbitCenter +
        Vector3.new(

            math.cos(
                OrbitAngle
            ) *
            radius,

            math.sin(
                OrbitAngle *
                0.6
            ) *
            3,

            math.sin(
                OrbitAngle
            ) *
            radius
        )


    root.AssemblyLinearVelocity =
        root.AssemblyLinearVelocity:Lerp(
            (
                targetPosition -
                root.Position
            ) *
            1.8,

            math.clamp(
                delta * 3,
                0,
                1
            )
        )

end



---------------------------------------------------------------

local XRayObjects = {}


local function ClearXRay()

    for object, highlight in pairs(
        XRayObjects
    ) do

        if highlight then
            highlight:Destroy()
        end


        XRayObjects[object] =
            nil

    end

end


local function AddXRay(
    object
)

    if not State.XRay then
        return
    end


    if not object:IsA("BasePart") then
        return
    end


    if Character
        and object:IsDescendantOf(
            Character
        ) then

        return

    end


    if XRayObjects[object] then
        return
    end


    local highlight =
        Instance.new("Highlight")


    highlight.Name =
        "UltraGptXRay"


    highlight.Adornee =
        object


    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop


    highlight.FillColor =
        C.WHITE

    highlight.FillTransparency =
        0.92


    highlight.OutlineColor =
        C.WHITE

    highlight.OutlineTransparency =
        0.4


    highlight.Parent =
        object


    XRayObjects[object] =
        highlight

end


local function SetXRay(
    enabled
)

    State.XRay =
        enabled


    ClearXRay()


    if enabled then

        local count =
            0


        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            if count >= 2500 then
                break
            end


            if object:IsA("BasePart")
                and not (
                    Character
                    and object:IsDescendantOf(
                        Character
                    )
                ) then

                AddXRay(
                    object
                )

                count +=
                    1

            end

        end


        Notify(
            "XRay",
            "Включён"
        )

    else

        Notify(
            "XRay",
            "Выключен"
        )

    end

end



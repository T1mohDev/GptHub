local function stopNoClip()
	State.NoClip = false
	disconnect("NoClip")

	if Character then
		for _, obj in ipairs(Character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = true
			end
		end
	end

	setToggle(NoClip, false)
end

local function startNoClip()
	State.NoClip = true

	Connections.NoClip = RunService.Stepped:Connect(function()
		if not State.NoClip or not Character then
			return
		end

		for _, obj in ipairs(Character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
			end
		end
	end)

	setToggle(NoClip, true)
end

NoClip.Button.MouseButton1Click:Connect(function()
	if State.NoClip then
		stopNoClip()
		notify("NoClip OFF")
	else
		startNoClip()
		notify("NoClip ON")
	end
end)


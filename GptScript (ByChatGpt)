local function SaveRainbowColors()

    table.clear(
        RainbowSaved
    )


    local char =
        GetCharacter()


    for _, object in ipairs(
        char:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            RainbowSaved[object] =
                object.Color

        end

    end

end


local function RestoreRainbowColors()

    for object, color in pairs(
        RainbowSaved
    ) do

        if object
            and object.Parent
            and object:IsA("BasePart") then

            object.Color =
                color

        end

    end


    table.clear(
        RainbowSaved
    )

end



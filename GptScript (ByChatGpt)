local function SavePosition()

    local _, _, root =
        GetCharacter()


    if root then

        SavedCFrame =
            root.CFrame


        Notify(
            "Position",
            "Позиция сохранена"
        )

    end

end


local function ReturnPosition()

    local _, _, root =
        GetCharacter()


    if not root then
        return
    end


    if not SavedCFrame then

        Notify(
            "Position",
            "Нет сохранённой позиции"
        )

        return
    end


    root.CFrame =
        SavedCFrame


    Notify(
        "Position",
        "Возвращено"
    )

end



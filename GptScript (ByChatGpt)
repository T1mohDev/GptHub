---------------------------------------------------------------
-- XRAY
---------------------------------------------------------------

local XRayObjects = {}


local function ClearXRay()

    for object, highlight in pairs(
        XRayObjects
    ) do

        if highlight then
            highlight:Destroy()
        end


        XRayObjects[object] =
            nil

    end

end


local function AddXRay(
    object
)

    if not State.XRay then
        return
    end


    if not object:IsA("BasePart") then
        return
    end


    if Character
        and object:IsDescendantOf(
            Character
        ) then

        return
    end


    if XRayObjects[object] then
        return
    end


    local highlight =
        Instance.new("Highlight")


    highlight.Name =
        "UltraGptXRay"


    highlight.Adornee =
        object


    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop


    highlight.FillColor =
        C.WHITE

    highlight.FillTransparency =
        0.92


    highlight.OutlineColor =
        C.WHITE

    highlight.OutlineTransparency =
        0.4


    highlight.Parent =
        object


    XRayObjects[object] =
        highlight

end


local function SetXRay(
    enabled
)

    State.XRay =
        enabled


    ClearXRay()


    if enabled then

        local count =
            0


        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            if count >= 2500 then
                break
            end


            if object:IsA("BasePart")
                and not (
                    Character
                    and object:IsDescendantOf(
                        Character
                    )
                ) then

                AddXRay(
                    object
                )

                count +=
                    1

            end
        end


        Notify(
            "XRay",
            "Включён"
        )

    else

        Notify(
            "XRay",
            "Выключен"
        )

    end

end


---------------------------------------------------------------
-- ESP
---------------------------------------------------------------

local ESPObjects = {}


local function ClearESP()

    for player, highlight in pairs(
        ESPObjects
    ) do

        if highlight then
            highlight:Destroy()
        end


        ESPObjects[player] =
            nil

    end

end


local function AddESP(
    player
)

    if player ==
        LocalPlayer then

        return
    end


    if not State.ESP then
        return
    end


    local character =
        player.Character


    if not character then
        return
    end


    if ESPObjects[player] then
        return
    end


    local highlight =
        Instance.new("Highlight")


    highlight.Name =
        "UltraGptESP"


    highlight.Adornee =
        character


    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop


    highlight.FillColor =
        C.WHITE

    highlight.FillTransparency =
        0.78


    highlight.OutlineColor =
        C.WHITE

    highlight.OutlineTransparency =
        0


    highlight.Parent =
        character


    ESPObjects[player] =
        highlight

end


local function SetESP(
    enabled
)

    State.ESP =
        enabled


    ClearESP()


    if enabled then

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            AddESP(
                player
            )

        end


        Notify(
            "ESP",
            "Игроки подсвечены"
        )

    else

        Notify(
            "ESP",
            "Выключен"
        )

    end

end


---------------------------------------------------------------
-- RAINBOW
---------------------------------------------------------------

local function SaveRainbowColors()

    table.clear(
        RainbowSaved
    )


    local char =
        GetCharacter()


    for _, object in ipairs(
        char:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            RainbowSaved[object] =
                object.Color

        end
    end

end


local function RestoreRainbowColors()

    for object, color in pairs(
        RainbowSaved
    ) do

        if object
            and object.Parent
            and object:IsA("BasePart") then

            object.Color =
                color

        end
    end


    table.clear(
        RainbowSaved
    )

end


local function SetRainbow(
    enabled
)

    State.Rainbow =
        enabled


    if enabled then

        SaveRainbowColors()


        Notify(
            "Rainbow",
            "Включён"
        )

    else

        RestoreRainbowColors()


        Notify(
            "Rainbow",
            "Исходные цвета восстановлены"
        )

    end

end


local function UpdateRainbow()

    if not State.Rainbow then
        return
    end


    RainbowHue +=
        0.003


    if RainbowHue > 1 then
        RainbowHue = 0
    end


    local color =
        Color3.fromHSV(
            RainbowHue,
            0.75,
            1
        )


    local char =
        GetCharacter()


    for _, object in ipairs(
        char:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            object.Color =
                color

        end
    end

end


